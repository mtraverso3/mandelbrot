// Static assets Worker serving the web viewer at mandelbrot.mtraverso.net
// Build with `web/build.sh`, deploy with `npx wrangler deploy`
{
  "name": "mandelbrot",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "mandelbrot.mtraverso.net", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": true
}
